# Статический сайт Lotsman Analytics. Railway передаёт порт в $PORT, HTTPS делает Railway.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Основной адрес — lotsman.kz: www переадресуем навсегда.
	@www host www.lotsman.kz
	redir @www https://lotsman.kz{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	@assets path /assets/* /favicon.svg /apple-touch-icon.png
	header @assets Cache-Control "public, max-age=604800"

	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
